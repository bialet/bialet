"        }\n"
"      }\n"
"      if (!__cookieJar.containsKey(reqHost)) __cookieJar[reqHost] = {}\n"
"      __cookieJar[reqHost][cookieName] = cookie\n"
"    }\n"
"  }\n"
"  static urlScope_(url) {\n"
