"      var cookieName = kv[0].trim()\n"
"      var cookie = {\"v\": kv[1].trim(), \"p\": \"/\", \"s\": false, \"e\": 0}\n"
"      for (i in 1...parts.count) {\n"
"        var attr = parts[i].trim()\n"
"        var eq = attr.indexOf(\"=\")\n"
"        var attrName = (eq >= 0 ? attr[0...eq] : attr).trim().lower\n"
"        var attrValue = eq >= 0 ? attr[eq + 1...attr.count].trim() : \"\"\n"
