"    _headers = {}\n"
"    if (_fullHeaders) {\n"
"      var tmp\n"
"      var headerName\n"
"      var headerValue\n"
"      for (line in _fullHeaders.split(\"\\n\")) {\n"
"        tmp = line.split(\":\")\n"
"        headerName = tmp.removeAt(0).trim().lower\n"
"        headerValue = tmp.join(\":\").trim().lower\n"
